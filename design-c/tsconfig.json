{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "baseUrl": "..",
    "paths": { "@/*": ["./src/*"] },
    "incremental": true
  },
  "include": [
    "next-env.d.ts",
    "app/**/*.tsx",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "next.config.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": ["../node_modules", "out"]
}
