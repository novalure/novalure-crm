{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://www.novalure-crm.app/schemas/final-preview-release-attestation-v2.json",
  "title": "Novalure final Preview release attestation",
  "description": "Fail-closed v2 evidence-attestation contract. The verifier enforces regular repository files, immutable run provenance, exact candidate/runtime bindings, SHA-256 sidecars and Ed25519 approvals rooted in an externally supplied trust anchor.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "schemaPath",
    "status",
    "decision",
    "runtime",
    "approvalTrust",
    "evidenceProvenance",
    "documentBundleSha256",
    "documents",
    "gateEvidence",
    "signatures"
  ],
  "properties": {
    "schemaVersion": { "const": 2 },
    "recordType": { "const": "FINAL_PREVIEW_RELEASE_ATTESTATION" },
    "schemaPath": {
      "const": "docs/audit/2026-08-23/final-preview-release-attestation.schema.json"
    },
    "status": {
      "enum": ["PENDING", "EVIDENCE_FROZEN", "SIGNED"]
    },
    "decision": {
      "enum": ["NO-GO", "CONDITIONAL_GO", "GO"]
    },
    "runtime": { "$ref": "#/$defs/runtime" },
    "approvalTrust": { "$ref": "#/$defs/approvalTrust" },
    "evidenceProvenance": { "$ref": "#/$defs/evidenceProvenance" },
    "documentBundleSha256": { "$ref": "#/$defs/nullableDigest" },
    "documents": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "prefixItems": [
        {
          "allOf": [
            { "$ref": "#/$defs/documentBinding" },
            {
              "properties": {
                "id": { "const": "database-recovery" },
                "path": { "const": "docs/audit/2026-08-23/database-recovery-evidence-manifest.json" },
                "sidecarPath": { "const": "docs/audit/2026-08-23/database-recovery-evidence-manifest.json.sha256" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/documentBinding" },
            {
              "properties": {
                "id": { "const": "release-surface-manifest" },
                "path": { "const": "docs/audit/2026-08-23/release-surface-manifest.json" },
                "sidecarPath": { "const": "docs/audit/2026-08-23/release-surface-manifest.json.sha256" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/documentBinding" },
            {
              "properties": {
                "id": { "const": "release-gate-matrix" },
                "path": { "const": "docs/audit/2026-08-23/release-gate-matrix.json" },
                "sidecarPath": { "const": "docs/audit/2026-08-23/release-gate-matrix.json.sha256" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/documentBinding" },
            {
              "properties": {
                "id": { "const": "legal-content-manifest" },
                "path": { "const": "docs/audit/2026-08-23/legal-content-manifest.json" },
                "sidecarPath": { "const": "docs/audit/2026-08-23/legal-content-manifest.json.sha256" }
              }
            }
          ]
        },
        {
          "allOf": [
            { "$ref": "#/$defs/documentBinding" },
            {
              "properties": {
                "id": { "const": "company-profile-approval" },
                "path": { "const": "docs/audit/2026-08-23/company-profile-approval.json" },
                "sidecarPath": { "const": "docs/audit/2026-08-23/company-profile-approval.json.sha256" }
              }
            }
          ]
        }
      ],
      "items": false
    },
    "gateEvidence": {
      "type": "array",
      "minItems": 11,
      "maxItems": 11,
      "prefixItems": [
        { "allOf": [{ "$ref": "#/$defs/gateEvidence" }, { "properties": { "id": { "const": "database-recovery" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateEvidence" }, { "properties": { "id": { "const": "two-tenant-rbac-crud" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateEvidence" }, { "properties": { "id": { "const": "preview-blob-lifecycle" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateEvidence" }, { "properties": { "id": { "const": "provider-boundaries" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateEvidence" }, { "properties": { "id": { "const": "public-form-funnel" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateEvidence" }, { "properties": { "id": { "const": "accessibility-browser" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateEvidence" }, { "properties": { "id": { "const": "performance" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateEvidence" }, { "properties": { "id": { "const": "observability" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateEvidence" }, { "properties": { "id": { "const": "security-supply-chain" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateEvidence" }, { "properties": { "id": { "const": "cleanup-null-rest" } } }] },
        { "allOf": [{ "$ref": "#/$defs/gateEvidence" }, { "properties": { "id": { "const": "runtime-logs" } } }] }
      ],
      "items": false
    },
    "signatures": {
      "type": "object",
      "additionalProperties": false,
      "required": ["product", "engineering", "security", "operations", "legal", "privacy", "sales-operations", "data-compliance"],
      "properties": {
        "product": { "$ref": "#/$defs/nullableSignature" },
        "engineering": { "$ref": "#/$defs/nullableSignature" },
        "security": { "$ref": "#/$defs/nullableSignature" },
        "operations": { "$ref": "#/$defs/nullableSignature" },
        "legal": { "$ref": "#/$defs/nullableSignature" },
        "privacy": { "$ref": "#/$defs/nullableSignature" },
        "sales-operations": { "$ref": "#/$defs/nullableSignature" },
        "data-compliance": { "$ref": "#/$defs/nullableSignature" }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "PENDING" } }, "required": ["status"] },
      "then": {
        "properties": {
          "decision": { "const": "NO-GO" },
          "documentBundleSha256": { "type": "null" },
          "approvalTrust": {
            "properties": {
              "trustAnchorId": { "type": "null" },
              "trustAnchorSha256": { "type": "null" },
              "verificationMode": { "const": "NOT_RUN" }
            }
          },
          "evidenceProvenance": {
            "properties": {
              "evidenceCommit": { "type": "null" },
              "repositoryState": { "const": "NOT_RUN" },
              "runDirectory": { "type": "null" },
              "runId": { "type": "null" }
            }
          },
          "runtime": {
            "properties": {
              "candidateCommit": { "type": "null" },
              "databaseBranchId": { "type": "null" },
              "deploymentId": { "type": "null" },
              "deploymentHost": { "type": "null" },
              "trustedHarnessSha": { "type": "null" },
              "shaIdentityStatus": { "const": "NOT_RUN" },
              "startedAt": { "type": "null" },
              "completedAt": { "type": "null" }
            }
          },
          "documents": {
            "items": {
              "properties": {
                "sha256": { "type": "null" },
                "verificationStatus": { "const": "NOT_RUN" }
              }
            }
          },
          "gateEvidence": {
            "items": {
              "properties": {
                "status": { "const": "NOT_RUN" },
                "path": { "type": "null" },
                "sidecarPath": { "type": "null" },
                "sha256": { "type": "null" },
                "candidateJsonPointer": { "type": "null" },
                "statusJsonPointer": { "type": "null" }
              }
            }
          }
        }
      },
      "else": {
        "properties": {
          "evidenceProvenance": {
            "properties": {
              "evidenceCommit": { "$ref": "#/$defs/commit" },
              "repositoryState": { "const": "CLEAN_TRACKED" },
              "runDirectory": { "$ref": "#/$defs/runDirectory" },
              "runId": { "$ref": "#/$defs/runId" }
            }
          },
          "runtime": {
            "properties": {
              "candidateCommit": { "$ref": "#/$defs/commit" },
              "databaseBranchId": { "type": "string", "pattern": "^br-[A-Za-z0-9-]{8,128}$" },
              "deploymentId": { "type": "string", "pattern": "^dpl_[A-Za-z0-9]{20,80}$" },
              "deploymentHost": { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.vercel\\.app$" },
              "trustedHarnessSha": { "$ref": "#/$defs/commit" },
              "shaIdentityStatus": { "const": "PASS" },
              "startedAt": { "$ref": "#/$defs/timestamp" },
              "completedAt": { "$ref": "#/$defs/timestamp" }
            }
          },
          "documents": {
            "items": {
              "properties": {
                "sha256": { "$ref": "#/$defs/digest" },
                "verificationStatus": { "const": "PASS" }
              }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "const": "SIGNED" } }, "required": ["status"] },
      "then": {
        "properties": {
          "approvalTrust": {
            "properties": {
              "trustAnchorId": { "$ref": "#/$defs/trustAnchorId" },
              "trustAnchorSha256": { "$ref": "#/$defs/digest" },
              "verificationMode": { "const": "ED25519_DETACHED" }
            }
          },
          "signatures": {
            "properties": {
              "product": { "$ref": "#/$defs/signature" },
              "engineering": { "$ref": "#/$defs/signature" },
              "security": { "$ref": "#/$defs/signature" },
              "operations": { "$ref": "#/$defs/signature" },
              "legal": { "$ref": "#/$defs/signature" },
              "privacy": { "$ref": "#/$defs/signature" },
              "sales-operations": { "$ref": "#/$defs/signature" },
              "data-compliance": { "$ref": "#/$defs/signature" }
            }
          }
        }
      },
      "else": {
        "properties": {
          "approvalTrust": {
            "properties": {
              "trustAnchorId": { "type": "null" },
              "trustAnchorSha256": { "type": "null" },
              "verificationMode": { "const": "NOT_RUN" }
            }
          },
          "signatures": {
            "properties": {
              "product": { "type": "null" },
              "engineering": { "type": "null" },
              "security": { "type": "null" },
              "operations": { "type": "null" },
              "legal": { "type": "null" },
              "privacy": { "type": "null" },
              "sales-operations": { "type": "null" },
              "data-compliance": { "type": "null" }
            }
          }
        }
      }
    },
    {
      "if": { "properties": { "decision": { "const": "GO" } }, "required": ["decision"] },
      "then": {
        "properties": {
          "status": { "const": "SIGNED" },
          "gateEvidence": {
            "items": { "properties": { "status": { "const": "PASS" } } }
          }
        }
      }
    }
  ],
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[a-f0-9]{40}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "nullableDigest": {
      "anyOf": [
        { "$ref": "#/$defs/digest" },
        { "type": "null" }
      ]
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"
    },
    "nullableRepositoryPath": {
      "anyOf": [
        { "$ref": "#/$defs/repositoryPath" },
        { "type": "null" }
      ]
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "nullableTimestamp": {
      "anyOf": [
        { "$ref": "#/$defs/timestamp" },
        { "type": "null" }
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^run-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}$"
    },
    "runDirectory": {
      "type": "string",
      "pattern": "^docs/audit/2026-08-23/final-evidence/runs/run-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}$"
    },
    "trustAnchorId": {
      "type": "string",
      "pattern": "^ta_[A-Za-z0-9_-]{8,120}$"
    },
    "keyId": {
      "type": "string",
      "pattern": "^key_[A-Za-z0-9_-]{8,120}$"
    },
    "signerSubject": {
      "type": "string",
      "pattern": "^subject:[A-Za-z0-9][A-Za-z0-9._:@/-]{7,240}$"
    },
    "detachedSignature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "signatureReference": {
      "type": "string",
      "pattern": "^urn:novalure:release-approval:v2:ta_[A-Za-z0-9_-]{8,120}:key_[A-Za-z0-9_-]{8,120}:(?:product|engineering|security|operations|legal|privacy|sales-operations|data-compliance):[a-f0-9]{64}$"
    },
    "approvalArtifactPath": {
      "allOf": [
        { "$ref": "#/$defs/repositoryPath" },
        { "pattern": "^docs/audit/2026-08-23/final-evidence/runs/run-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}/approvals/(?:product|engineering|security|operations|legal|privacy|sales-operations|data-compliance)\\.json$" }
      ]
    },
    "approvalArtifactSidecarPath": {
      "allOf": [
        { "$ref": "#/$defs/repositoryPath" },
        { "pattern": "^docs/audit/2026-08-23/final-evidence/runs/run-[0-9]{8}T[0-9]{6}Z-[a-f0-9]{12}/approvals/(?:product|engineering|security|operations|legal|privacy|sales-operations|data-compliance)\\.json\\.sha256$" }
      ]
    },
    "approvalTrust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["trustAnchorId", "trustAnchorSha256", "verificationMode"],
      "properties": {
        "trustAnchorId": {
          "anyOf": [{ "$ref": "#/$defs/trustAnchorId" }, { "type": "null" }]
        },
        "trustAnchorSha256": { "$ref": "#/$defs/nullableDigest" },
        "verificationMode": { "enum": ["NOT_RUN", "ED25519_DETACHED"] }
      }
    },
    "evidenceProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceCommit", "repositoryState", "runDirectory", "runId"],
      "properties": {
        "evidenceCommit": {
          "anyOf": [{ "$ref": "#/$defs/commit" }, { "type": "null" }]
        },
        "repositoryState": { "enum": ["NOT_RUN", "CLEAN_TRACKED"] },
        "runDirectory": {
          "anyOf": [{ "$ref": "#/$defs/runDirectory" }, { "type": "null" }]
        },
        "runId": {
          "anyOf": [{ "$ref": "#/$defs/runId" }, { "type": "null" }]
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branch",
        "environment",
        "candidateCommit",
        "databaseBranchId",
        "deploymentId",
        "deploymentHost",
        "trustedHarnessSha",
        "shaIdentityStatus",
        "startedAt",
        "completedAt",
        "productionMutationPerformed"
      ],
      "properties": {
        "branch": { "type": "string", "pattern": "^codex/" },
        "environment": { "const": "PREVIEW" },
        "candidateCommit": {
          "anyOf": [{ "$ref": "#/$defs/commit" }, { "type": "null" }]
        },
        "databaseBranchId": {
          "anyOf": [
            { "type": "string", "pattern": "^br-[A-Za-z0-9-]{8,128}$" },
            { "type": "null" }
          ]
        },
        "deploymentId": {
          "anyOf": [
            { "type": "string", "pattern": "^dpl_[A-Za-z0-9]{20,80}$" },
            { "type": "null" }
          ]
        },
        "deploymentHost": {
          "anyOf": [
            { "type": "string", "pattern": "^[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?\\.vercel\\.app$" },
            { "type": "null" }
          ]
        },
        "trustedHarnessSha": {
          "anyOf": [{ "$ref": "#/$defs/commit" }, { "type": "null" }]
        },
        "shaIdentityStatus": { "enum": ["NOT_RUN", "PASS"] },
        "startedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "completedAt": { "$ref": "#/$defs/nullableTimestamp" },
        "productionMutationPerformed": { "const": false }
      }
    },
    "documentBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "path",
        "sidecarPath",
        "candidateJsonPointer",
        "sha256",
        "verificationStatus"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/repositoryPath" },
        "sidecarPath": { "$ref": "#/$defs/repositoryPath" },
        "candidateJsonPointer": { "const": "/candidateCommit" },
        "sha256": { "$ref": "#/$defs/nullableDigest" },
        "verificationStatus": { "enum": ["NOT_RUN", "PASS"] }
      }
    },
    "gateEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "requiredForGo",
        "status",
        "path",
        "sidecarPath",
        "sha256",
        "candidateJsonPointer",
        "statusJsonPointer"
      ],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "requiredForGo": { "const": true },
        "status": { "enum": ["PASS", "FAIL", "BLOCKED", "NOT_RUN", "PENDING_SIGNATURE"] },
        "path": { "$ref": "#/$defs/nullableRepositoryPath" },
        "sidecarPath": { "$ref": "#/$defs/nullableRepositoryPath" },
        "sha256": { "$ref": "#/$defs/nullableDigest" },
        "candidateJsonPointer": {
          "anyOf": [
            { "type": "string", "pattern": "^/[A-Za-z][A-Za-z0-9]*(?:/[A-Za-z][A-Za-z0-9]*)*$" },
            { "type": "null" }
          ]
        },
        "statusJsonPointer": {
          "anyOf": [
            { "type": "string", "pattern": "^/[A-Za-z][A-Za-z0-9]*(?:/[A-Za-z][A-Za-z0-9]*)*$" },
            { "type": "null" }
          ]
        }
      }
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "role",
        "signedAt",
        "candidateCommit",
        "deploymentId",
        "decision",
        "documentBundleSha256",
        "acceptedRiskReferences",
        "approvalScopes",
        "signatureAlgorithm",
        "detachedSignature",
        "keyId",
        "signerSubject",
        "trustAnchorId",
        "signatureReference",
        "approvalArtifactPath",
        "approvalArtifactSidecarPath",
        "approvalArtifactSha256"
      ],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["product", "engineering", "security", "operations", "legal", "privacy", "sales-operations", "data-compliance"] },
        "signedAt": { "$ref": "#/$defs/timestamp" },
        "candidateCommit": { "$ref": "#/$defs/commit" },
        "deploymentId": { "type": "string", "pattern": "^dpl_[A-Za-z0-9]{20,80}$" },
        "decision": { "enum": ["NO-GO", "CONDITIONAL_GO", "GO"] },
        "documentBundleSha256": { "$ref": "#/$defs/digest" },
        "acceptedRiskReferences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "approvalScopes": {
          "type": "array",
          "minItems": 2,
          "items": { "enum": ["DATA_COMPLIANCE", "ENGINEERING", "FINAL_RELEASE", "LEGAL_CONTENT", "OPERATIONS", "PRIVACY_CONTENT", "PRODUCT", "SECURITY", "UNIT_BUYER_DEAL"] },
          "uniqueItems": true
        },
        "signatureAlgorithm": { "const": "Ed25519" },
        "detachedSignature": { "$ref": "#/$defs/detachedSignature" },
        "keyId": { "$ref": "#/$defs/keyId" },
        "signerSubject": { "$ref": "#/$defs/signerSubject" },
        "trustAnchorId": { "$ref": "#/$defs/trustAnchorId" },
        "signatureReference": { "$ref": "#/$defs/signatureReference" },
        "approvalArtifactPath": { "$ref": "#/$defs/approvalArtifactPath" },
        "approvalArtifactSidecarPath": { "$ref": "#/$defs/approvalArtifactSidecarPath" },
        "approvalArtifactSha256": { "$ref": "#/$defs/digest" }
      }
    },
    "nullableSignature": {
      "anyOf": [
        { "$ref": "#/$defs/signature" },
        { "type": "null" }
      ]
    },
    "externalApprovalArtifact": {
      "$comment": "Schema v2 for each separately hashed approval receipt; the runtime verifier also checks every value against the corresponding attestation signature and verifies the detached Ed25519 signature.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "recordType",
        "name",
        "role",
        "signedAt",
        "candidateCommit",
        "deploymentId",
        "decision",
        "documentBundleSha256",
        "acceptedRiskReferences",
        "approvalScopes",
        "signatureAlgorithm",
        "detachedSignature",
        "keyId",
        "signerSubject",
        "trustAnchorId",
        "signatureReference"
      ],
      "properties": {
        "schemaVersion": { "const": 2 },
        "recordType": { "const": "NOVALURE_EXTERNAL_RELEASE_APPROVAL" },
        "name": { "type": "string", "minLength": 1 },
        "role": { "enum": ["product", "engineering", "security", "operations", "legal", "privacy", "sales-operations", "data-compliance"] },
        "signedAt": { "$ref": "#/$defs/timestamp" },
        "candidateCommit": { "$ref": "#/$defs/commit" },
        "deploymentId": { "type": "string", "pattern": "^dpl_[A-Za-z0-9]{20,80}$" },
        "decision": { "enum": ["NO-GO", "CONDITIONAL_GO", "GO"] },
        "documentBundleSha256": { "$ref": "#/$defs/digest" },
        "acceptedRiskReferences": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "approvalScopes": {
          "type": "array",
          "minItems": 2,
          "items": { "enum": ["DATA_COMPLIANCE", "ENGINEERING", "FINAL_RELEASE", "LEGAL_CONTENT", "OPERATIONS", "PRIVACY_CONTENT", "PRODUCT", "SECURITY", "UNIT_BUYER_DEAL"] },
          "uniqueItems": true
        },
        "signatureAlgorithm": { "const": "Ed25519" },
        "detachedSignature": { "$ref": "#/$defs/detachedSignature" },
        "keyId": { "$ref": "#/$defs/keyId" },
        "signerSubject": { "$ref": "#/$defs/signerSubject" },
        "trustAnchorId": { "$ref": "#/$defs/trustAnchorId" },
        "signatureReference": { "$ref": "#/$defs/signatureReference" }
      }
    }
  }
}
