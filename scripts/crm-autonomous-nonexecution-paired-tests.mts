import assert from "node:assert/strict";
import {createHash,randomUUID} from "node:crypto";
import {execFileSync} from "node:child_process";
import {readFile} from "node:fs/promises";
import path from "node:path";
import {pathToFileURL} from "node:url";
import {test} from "node:test";
import {autonomousNonexecutionFixture} from "./crm-autonomous-nonexecution-tests";
import {handleAutonomousCrmNonexecution} from "../src/lib/crm-autonomous-nonexecution";
import type {TenantPool} from "../src/lib/db/tenant-client";
const modulePath=process.env.CRM_PAIRED_NONEXECUTION_MODULE,revision=process.env.CRM_PAIRED_NONEXECUTION_REVISION;
if(!modulePath||!revision||!/^[a-f0-9]{40}$/.test(revision))throw new Error("EXACT_NONEXECUTION_COUNTERPART_REQUIRED");
const absolute=path.resolve(modulePath),checkout=path.resolve(process.env.CRM_PAIRED_NONEXECUTION_CHECKOUT??path.resolve(path.dirname(absolute),"../../.."));
assert.equal(execFileSync("git",["-C",checkout,"rev-parse","HEAD"],{encoding:"utf8",windowsHide:true}).trim(),revision);
assert.equal(execFileSync("git",["-C",checkout,"status","--porcelain","--untracked-files=no"],{encoding:"utf8",windowsHide:true}).trim(),"");
const actual=await import(pathToFileURL(absolute).href),compiledSha256=createHash("sha256").update(await readFile(absolute)).digest("hex");
if(process.env.CRM_PAIRED_NONEXECUTION_CHECKOUT)assert.equal(compiledSha256,process.env.CRM_PAIRED_NONEXECUTION_MODULE_SHA256);
for(const receiverBound of [false,true])test(`actual recovery client and CRM receiver preserve original closure (${receiverBound?"signed receiver binding":"legacy"})`,async()=>{
 const {f,recovery,auth,token,authority,binding,invoke}=autonomousNonexecutionFixture();let attempts=0,serverCalls=0,dropBefore=false,dropAfter=false,serverReceipt:Record<string,unknown>|undefined,versionGets=0;
 const receiver={origin:"https://novalure-synthetic-v2-novalure.vercel.app",deploymentId:"dpl_SyntheticV2Receiver",gitSha:"d".repeat(40)},receiverOption=receiverBound?{receiver}:{};
 const machineAuth={...auth(),env:{...auth().env,NODE_ENV:"production" as const,...(receiverBound?{VERCEL:"1",VERCEL_PROJECT_ID:"prj_R32Okl6AHijTohvuKmryuTLjWMsk",VERCEL_DEPLOYMENT_ID:receiver.deploymentId,VERCEL_GIT_COMMIT_SHA:receiver.gitSha}:{})}};
 const fetcher:typeof fetch=async(input,init)=>{attempts++;const request=new Request(String(input),init);if(request.method==="GET"){assert.equal(receiverBound,true);assert.equal(request.url,receiver.origin+"/api/version");assert.ok(request.headers.get("x-vercel-trusted-oidc-idp-token")?.startsWith("eyJ"));versionGets++;return Response.json({deploymentId:receiver.deploymentId,gitSha:receiver.gitSha});}if(dropBefore){dropBefore=false;throw new Error("SYNTHETIC undelivered recovery");}const proof=JSON.parse(Buffer.from(request.headers.get("x-evelyn-recovery")!.split(".")[2]!,"base64url").toString("utf8"));assert.equal(Object.hasOwn(proof,"receiverDeploymentId"),receiverBound);assert.equal(Object.hasOwn(proof,"receiverRevision"),receiverBound);if(receiverBound){assert.equal(proof.receiverDeploymentId,receiver.deploymentId);assert.equal(proof.receiverRevision,receiver.gitSha);}serverCalls++;const response=await handleAutonomousCrmNonexecution(request,{pool:f.db.pool as unknown as TenantPool,machineAuth});if(response.status===200)serverReceipt=await response.clone().json();if(dropAfter){dropAfter=false;await response.arrayBuffer();throw new Error("SYNTHETIC committed close response lost");}return response;};
 const make=async()=>{const r=f.registration("Task",randomUUID(),{scopes:["crm.tasks.read","crm.tasks.create"],module:{contractVersion:"crm-autonomous-access-v2",readFields:["title"],writeFields:["title"],relatedResources:{},lifecycleMode:"CREATE"}});await f.provision(r);const body=f.body("Create",{title:"SYNTHETIC paired nonexecution"}),b=binding(r,body),id=await authority(r.grantId),client=actual.createCrmNonexecutionClient(b,{recoveryAuthorityId:id,resolveRecoverySigningKey:async()=>recovery.privateKey,getToken:token,fetch:fetcher,...receiverOption});return {r,body,b,client};};
 const fenced=await make();dropAfter=true;assert.equal((await fenced.client.close(fenced.body)).outcome,"UNKNOWN");const reference=serverReceipt?.closureReference,recovered=await fenced.client.close(fenced.body);assert.equal(recovered.outcome,"CONFIRMED");assert.equal(recovered.receipt.outcome,"NO_EFFECT");assert.equal(recovered.receipt.closureReference,reference);assert.equal(recovered.receipt.replayed,true);assert.notEqual((await invoke(fenced.r,fenced.body)).status,200);assert.equal((await f.db.admin.query("select count(*) from tasks where id=$1",[fenced.r.sourceId])).rows[0].count,"0");
 const undelivered=await make();dropBefore=true;assert.equal((await undelivered.client.close(undelivered.body)).outcome,"UNKNOWN");assert.equal((await f.db.admin.query("select count(*) from crm_autonomous_nonexecution_closures where grant_id=$1",[undelivered.r.grantId])).rows[0].count,"0");const applied=await invoke(undelivered.r,undelivered.body);assert.equal(applied.status,200);const observed=await undelivered.client.close(undelivered.body);assert.equal(observed.outcome,"CONFIRMED");assert.equal(observed.receipt.outcome,"APPLIED");assert.equal(observed.receipt.replayed,true);assert.equal(observed.receipt.auditReference,applied.body.auditReference);assert.equal("data" in observed.receipt,false);
 assert.equal(versionGets>0,receiverBound);console.log("NONEXECUTION_PAIRED_EVIDENCE "+JSON.stringify({evelynRevision:revision,compiledSha256,attempts,serverCalls,receiverBound,versionGets,versionReadback:"SYNTHETIC_LOCAL_STUB_ONLY",actualReceiver:true,actualPostgreSQL:true,rsaAndEd25519:true,scope:"SYNTHETIC_LOCAL_ONLY",lostCloseAck:"STABLE_NO_EFFECT_NO_LATE_MUTATION",undeliveredClose:"UNKNOWN_NO_TOMBSTONE_THEN_ORIGINAL_APPLIED"}));
});
